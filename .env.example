# Copiá este archivo a .env.local y completá lo que necesites.
# Sin ninguna variable seteada el proyecto corre entero offline: PGlite + provider mock.

# Postgres real (producción / Supabase). Vacío o ausente ⇒ PGlite embebido:
# persistido en data/pglite/ en desarrollo, en memoria cuando NODE_ENV=test.
DATABASE_URL=

# Habilita el provider real de análisis (Claude). Sin la key se usa el provider
# mock determinístico. Los tests NUNCA usan esta variable.
ANTHROPIC_API_KEY=

# Modelo usado por el provider real de análisis. Default: claude-sonnet-5.
ANALYSIS_MODEL=claude-sonnet-5

# Secreto para las cookies de sesión. En producción, un valor largo y aleatorio
# (por ejemplo: openssl rand -hex 32).
SESSION_SECRET=
